# =============================================================================
# Context-Cost Protocol — Environment Template
# Copy to .env and fill values. Never commit .env.
# =============================================================================

# --- LiteLLM Proxy --------------------------------------------------------
LITELLM_PROXY_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-1234

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# For litellm_config.yaml os.environ mapping
ANTHROPIC_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Redis (metering hot path) --------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Solana / Anchor ------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_PROGRAM_ID=CtxCost111111111111111111111111111111111111
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json

# --- Context-Cost Budget --------------------------------------------------
SEGMENT_CAP_TOKENS=100000
PRICE_PER_1K_TOKENS_USD=0.003
STREAM_MICRO_SETTLE=false
STREAM_SETTLE_EVERY_N_TOKENS=500

# --- Gateway --------------------------------------------------------------
GATEWAY_PORT=8000

# --- Colosseum Copilot (hackathon agent API) ------------------------------
# Used by the gateway to authenticate against the Colosseum Copilot service
# for segment metadata / budget sync. Get your PAT at:
# https://colosseum-copilot.nousresearch.com
COLOSSEUM_COPILOT_PAT=cc_pat_xxxxxxxxxxxxxxxx
COLOSSEUM_COPILOT_API_BASE=https://api.colosseum-copilot.nousresearch.com/v1
